# syntax=docker/dockerfile:1
FROM node:22-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev && \
    cd /app/node_modules/better-sqlite3 && \
    /app/node_modules/.bin/prebuild-install
COPY --from=builder /app/dist ./dist
COPY skills/ ./skills/
COPY agents/ ./agents/
COPY assets/ ./assets/

# hyperdht bootstrap CLI is a transitive dep, expose it
RUN ln -s /app/node_modules/.bin/hyperdht /usr/local/bin/hyperdht || true

# Pre-download CRSQLite extension for team sync (linux/x64).
# This creates settings.json as a side effect; entrypoints delete it so DB_PATH takes effect.
RUN echo "import { downloadCrsqlite } from '/app/dist/team/crsqlite.js'; await downloadCrsqlite();" | node --input-type=module

ENTRYPOINT ["node"]
